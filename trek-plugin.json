{
  "id": "wanderlog-import",
  "name": "Wanderlog Import",
  "version": "1.0.0",
  "apiVersion": 1,
  "author": "lahlafi",
  "description": "Import a trip from Wanderlog into TREK by pasting its view URL — recreates days, places, notes, flights, and hotel stays.",
  "homepage": "https://github.com/daniel-lahlafi/TREK-Wanderlog-plugin",
  "license": "MIT",
  "icon": "Plane",
  "type": "page",
  "trek": ">=3.4.0 <4.0.0",
  "nativeModules": false,
  "permissions": [
    "db:own",
    "db:read:trips",
    "db:read:categories",
    "db:create:trips",
    "db:write:trips",
    "db:write:days",
    "db:write:places",
    "db:write:itinerary",
    "db:write:daynotes",
    "db:write:accommodations",
    "db:write:reservations",
    "db:meta",
    "http:outbound:wanderlog.com"
  ],
  "egress": ["wanderlog.com"],
  "routes": [
    { "method": "POST", "path": "/import", "auth": true },
    { "method": "POST", "path": "/continue", "auth": true },
    { "method": "GET", "path": "/progress", "auth": true }
  ]
}
